# Existing CRM OAuth values can remain as-is.
CLIENT_ID="1000.xxxxx"
CLIENT_SECRET="xxxxx"
REFRESH_TOKEN="1000.xxxxx"
ACCESS_TOKEN="1000.xxxxx"
API_DOMAIN="https://www.zohoapis.com"

# Required for Zoho Analytics MCP.
# If these are omitted, app.py falls back to CLIENT_ID / CLIENT_SECRET / REFRESH_TOKEN
# for the three OAuth values below, but ANALYTICS_ORG_ID is still required.
ANALYTICS_CLIENT_ID="1000.xxxxx"
ANALYTICS_CLIENT_SECRET="xxxxx"
ANALYTICS_REFRESH_TOKEN="1000.xxxxx"
ANALYTICS_ORG_ID="xxxxxxxxx"

# Change these if your Zoho account is not in the .com data center.
ACCOUNTS_SERVER_URL="https://accounts.zoho.com"
ANALYTICS_SERVER_URL="https://analyticsapi.zoho.com"

OLLAMA_MODEL="qwen3.5:9b"
OLLAMA_URL="http://localhost:11434"
